# Copy to .env (local) and set the same variables in Vercel (Production + Preview). Never commit real values.

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API. The URL and anon key are public by design (they ship to the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row-level security. Never prefix with VITE_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Pickaxe (idea validation report engine) ──────────────────────────────
# The deployment id is the bearer token for the Pickaxe API. Server-side only.
PICKAXE_DEPLOYMENT_ID=

# ── Optional ─────────────────────────────────────────────────────────────
# Validations allowed per user per 24h (default 5)
IDEA_DAILY_LIMIT=5
