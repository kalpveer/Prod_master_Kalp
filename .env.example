# Copy to .env (local). Never commit real values.

# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API. The URL and anon key are public by design (they ship to the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row-level security. Never prefix with VITE_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Pickaxe (Supabase Edge Functions only; the deployment id is the bearer token) ────────
# Set these with: supabase secrets set PICKAXE_DEPLOYMENT_ID=... PICKAXE_GRANTS_DEPLOYMENT_ID=...
PICKAXE_DEPLOYMENT_ID=
PICKAXE_GRANTS_DEPLOYMENT_ID=

# ── Optional ─────────────────────────────────────────────────────────────
# Validations allowed per user per 24h (default 5)
IDEA_DAILY_LIMIT=5
